<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.charm.discovery-prewarm</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/sarahbachmeier/Projects/charm-discovery-generator/local/daily-run.mjs</string>
    <!-- The server posts the 08:00 digest. This job only generates, except
         when it generates something AFTER the digest already went out, in
         which case daily-run.mjs posts a short catch-up message itself. -->
    <string>--catch-up</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/sarahbachmeier/Projects/charm-discovery-generator</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- claude lives in ~/.local/bin, node in homebrew. launchd has a bare PATH. -->
    <key>PATH</key>
    <string>/Users/sarahbachmeier/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Run every 30 minutes rather than once at 06:30. The job is idempotent:
       it skips decks that already exist and exits in about two seconds when
       there is nothing to do. So whenever the Mac is on, it catches up within
       half an hour instead of missing the day entirely. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <!-- Also run the moment the agent loads, which is at login. A Mac that was
       off overnight starts catching up as soon as you sit down at it. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/sarahbachmeier/Projects/charm-discovery-generator/local/prewarm.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sarahbachmeier/Projects/charm-discovery-generator/local/prewarm.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
